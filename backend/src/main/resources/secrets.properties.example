# Copy this file to secrets.properties (same folder) and fill in your values.
# secrets.properties is gitignored. Never commit it.

# Gmail SMTP: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords  (enter it without spaces)
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=abcdefghijklmnop

# Web push keys. Generate with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@gmail.com

# Optional overrides
# DB_URL=jdbc:mysql://localhost:3306/expense_tracker
# DB_USERNAME=root
# DB_PASSWORD=root
# JWT_SECRET=
# APP_URL=http://localhost:5173
